+    def encode(self, X, mask, residue_idx, chain_encoding_all):
+        """Encoder-only forward: returns per-residue node embeddings h_V
+        [B, L, hidden_dim] after the unmasked self-attention encoder, WITHOUT
+        running the autoregressive decoder. Structure-only — takes no sequence
